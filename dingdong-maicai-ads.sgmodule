#!name=叮咚买菜去广告
#!desc=叮咚买菜轻量去广告模块。清理开屏、弹窗、首页广告位和常见营销浮层，尽量不影响下单、购物车和支付。
#!system=ios

[Rule]
DOMAIN,trackercollect.ddxq.mobi,REJECT

[URL Rewrite]
^https?:\/\/[^\/]*ddxq\.(mobi|com)\/.*(splash|startup|launch|advert|advertise|popup|pop_up|ad_config|adconf|adzone) - reject-200
^https?:\/\/[^\/]*(ddxq|dingdongxiaoqu)\.(mobi|com)\/.*\/(ad|ads|advert|advertise)(\/|\?|$) - reject-200

[Script]
叮咚买菜_统一网关净化 = type=http-response,requires-body=1,max-size=0,pattern=^https?:\/\/pubgw\.api\.ddxq\.mobi\/,script-path=https://cdn.jsdelivr.net/gh/Invictus0127/surge-modules@main/dingdong-maicai-ads.js
叮咚买菜_响应体净化 = type=http-response,requires-body=1,max-size=0,pattern=^https?:\/\/[^\/]*(ddxq|dingdongxiaoqu)\.(mobi|com)\/.*(home|index|config|page|tab|banner|popup|splash|startup|launch|advert|marketing|activity|promotion),script-path=https://cdn.jsdelivr.net/gh/Invictus0127/surge-modules@main/dingdong-maicai-ads.js

[MITM]
hostname = %APPEND% pubgw.api.ddxq.mobi,*.api.ddxq.mobi,api.ddxq.mobi,*.m.ddxq.mobi,m.ddxq.mobi,*.bsapi.ddxq.mobi,bsapi.ddxq.mobi,*.solar.ddxq.mobi,solar.ddxq.mobi,trackercollect.ddxq.mobi,*.ddxq.mobi,ddxq.mobi,*.ddxq.com,*.dingdongxiaoqu.com,*.dingdongxiaoqu.mobi
